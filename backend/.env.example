# ── 서버 ──────────────────────────────────────
PORT=3000
NODE_ENV=development
# 사이트맵·canonical 도메인
PUBLIC_SITE_URL=https://global-spay.com

# ── DB ────────────────────────────────────────
# 로컬: sqlite
DATABASE_TYPE=sqlite
DATABASE_PATH=data/newlink.sqlite

# Render/운영: PostgreSQL (DATABASE_URL이 있으면 이 값이 우선)
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/newlink
# DATABASE_SSL_DISABLE=false
# 운영 첫 배포·스키마 변경 시에만 true (이후 false 권장)
# TYPEORM_SYNC=true

# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=newlink
# DATABASE_PASSWORD=your_password
# DATABASE_NAME=newlink

# ── JWT (미니앱 자동 로그인) ─────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# ── 텔레그램 봇 (BotFather에서 발급) ─────────
# 형식: 1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ⚠ Git·스크린샷에 올리지 마세요. 유출 시 /revoke 후 재발급
TELEGRAM_BOT_TOKEN=your_bot_token_here
# BotFather → Bot Settings → Web Login 의 Client ID (보통 봇 숫자 ID와 동일, 다르면 명시)
# TELEGRAM_CLIENT_ID=1234567890

# 관리자 텔레그램 숫자 ID (쉼표로 여러 명)
# @userinfobot 에게 /start 하면 id 확인 가능
TELEGRAM_ADMIN_IDS=123456789
# 봇 username (@ 없이). 운영자 인증 안내에 사용
TELEGRAM_BOT_USERNAME=newlinkcom_bot

# ── TON 결제 (Promoted 유료 노출, 미사용 시 더미값 유지) ──
# 1000000000 = 1 TON (나노톤 단위)
TELEGRAM_PAYMENT_PROVIDER_TOKEN=your_ton_provider_token
PROMOTION_PRICE_TON=1000000000
PROMOTION_DURATION_DAYS=7

# ── 개발 전용 (운영/미니앱에서는 반드시 false) ──
DEV_ADMIN_BYPASS=false

# ── 브라우저 관리자 로그인 (/admin) ──
# 평문 비밀번호는 저장하지 않는다. 해시는 `npm run admin:hash-password` 로 만든다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ── TGStat API (자동관리 대량 동기화, 선택) ──
# https://tgstat.ru / https://api.tgstat.ru
# 한국은 국가 목록에 없으므로 country는 비우고 language=korean 사용
TGSTAT_API_TOKEN=
TGSTAT_COUNTRY=
TGSTAT_LANGUAGE=korean

# ── Serper (자동관리 주제 검색 수집, 권장) ──
# https://serper.dev 에서 API Key 발급 (Google CSE 결제 이슈 대안)
SERPER_API_KEY=

# ── Google Custom Search (선택, Serper 없을 때 폴백) ──
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ── OpenAI (후보 카테고리 AI 자동 분류, 선택) ──
# 없으면 키워드 폴백으로 분류합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 아바타 로컬 미러 (uploads/). Render Free는 디스크가 사라지므로 기본 비활성.
# true 로 강제하면 로컬 파일로 저장합니다. 미설정 시 RENDER=true 이면 프록시 URL 사용.
# AVATAR_MIRROR_LOCAL=false

# ── 통계 수집 크론 (매일 KST 03:00, 로컬은 끄기) ──
STATS_CRON_ENABLED=false
# 수집 시간 예산(분). 끝나면 남은 채널·발견 후보는 다음 회차에 이어서.
COLLECT_LIGHT_BUDGET_MIN=25
COLLECT_FULL_BUDGET_MIN=70
DISCOVERY_BUDGET_MIN=15
DISCOVERY_QUEUED_MAX_PER_DAY=300
VERIFY_RECHECK_BUDGET_MIN=5
# POST /api/internal/stats/run 헤더 X-Internal-Token 과 같아야 합니다.
INTERNAL_CRON_TOKEN=

# ── MTProto 일반 계정 수집 (기본 꺼짐) ────────
# true 여도 세션이 없으면 기존 t.me 수집을 씁니다.
MTPROTO_ENABLED=false
MTPROTO_DAILY_LIMIT=3000
RESOLVE_DAILY_LIMIT=50
KEYWORD_SEARCH_DAILY_LIMIT=10
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
