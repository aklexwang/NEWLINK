# 로컬 개발
VITE_API_BASE_URL=http://localhost:3000/api

# Telegram Login Widget (BotFather 봇 username, @ 없이)
# BotFather → /setdomain → global-spay.com 등록 필요
VITE_TELEGRAM_BOT_USERNAME=telllink_bot

# Cloudflare Pages 배포 시 Environment variables 에도 설정
